# Copy this file to .env.local and fill in values from
# Supabase Dashboard → Project Settings → API Keys / Data API.
# NEVER commit .env.local.

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The *publishable* key (sb_publishable_...). It is safe in the browser
# because every table and file is protected by Row Level Security.
# Older projects can use the legacy "anon" public key here instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Upload limits in megabytes (also enforced by the storage bucket limit and
# re-checked on the server when an attachment is registered).
# The Supabase free tier allows at most 50 MB per file.
NEXT_PUBLIC_MAX_IMAGE_MB=15
NEXT_PUBLIC_MAX_AUDIO_MB=25
NEXT_PUBLIC_MAX_DOCUMENT_MB=25

# NOTE: This app intentionally does NOT need the service_role / secret key.
# Do not add it to Vercel or to this file.
